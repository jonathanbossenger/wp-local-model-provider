{
    "name": "jonathanbossenger/wp-ollama-model-provider",
    "description": "Ollama AI model provider for WordPress AI Client. Enables WordPress to use Ollama models locally or in the cloud.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "ai",
        "ollama",
        "local",
        "cloud",
        "machine-learning",
        "llm",
        "wordpress-plugin"
    ],
    "homepage": "https://github.com/jonathanbossenger/wp-ollama-model-provider",
    "authors": [
        {
            "name": "Jonathan Bossenger",
            "email": "jonathan@jonathanbossenger.com",
            "homepage": "https://github.com/jonathanbossenger",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/jonathanbossenger/wp-ollama-model-provider/issues",
        "source": "https://github.com/jonathanbossenger/wp-ollama-model-provider"
    },
    "require": {
        "php": ">=8.0",
        "wordpress/wp-ai-client": "^0.2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "WpOllamaModelProvider\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpOllamaModelProvider\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=WordPress wp-ollama-model-provider.php includes/",
        "phpcbf": "phpcbf --standard=WordPress wp-ollama-model-provider.php includes/"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
